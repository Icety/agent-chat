{
  "name": "@icety/agent-chat",
  "version": "0.1.0",
  "description": "Chat with Claude Code agents from a Nuxt app: sessions in tmux, a Claude Code channel, live events, and the chat UI.",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./nuxt.config": "./nuxt.config.ts",
    "./package.json": "./package.json",
    "./lib/*": "./lib/*.ts",
    "./shared/*": "./shared/*.ts",
    "./app/utils/*": "./app/utils/*.ts",
    "./server/utils/*": "./server/utils/*.ts",
    "./channel/*": "./channel/*",
    "./app/assets/*": "./app/assets/*"
  },
  "files": [
    "app",
    "server",
    "shared",
    "lib",
    "channel",
    "nuxt.config.ts",
    "README.md"
  ],
  "scripts": {
    "dev": "nuxt dev playground",
    "build": "nuxt build playground",
    "typecheck": "nuxt typecheck playground && tsc -p tsconfig.lib.json",
    "test": "bun test",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.pg.config.ts",
    "prepare:playground": "nuxt prepare playground"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.0.14",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/ui": "^4.11.3",
    "@types/bun": "^1.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  }
}
